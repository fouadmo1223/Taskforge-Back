# ─────────────────────────────────────────────────────────────
# FlowDesk — environment template. Copy to apps/api/.env and fill in.
# Never commit a real .env file.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── API ──────────────────────────────────────────────────────
API_PORT=4000
API_GLOBAL_PREFIX=api/v1
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000

# ── Database (MongoDB 8+) ────────────────────────────────────
# Local docker:  mongodb://localhost:27017/flowdesk
# Atlas:         mongodb+srv://user:pass@cluster0.xxxx.mongodb.net/flowdesk?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/flowdesk

# ── Redis (membership-context cache; optional-tolerant) ──────
REDIS_URL=redis://localhost:6379

# ── Realtime (Ably — replaces Socket.IO, runs on serverless) ─
# Create a free app at https://ably.com and paste the API key.
# When empty, realtime is skipped and the UI falls back to polling.
ABLY_API_KEY=

# ── Auth / JWT ──────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_TTL=1209600
AUTH_COOKIE_DOMAIN=localhost
AUTH_COOKIE_SECURE=false
# 'none' + AUTH_COOKIE_SECURE=true is required when the web app and API are
# deployed on different sites (e.g. two separate Vercel projects/domains).
AUTH_COOKIE_SAMESITE=lax

# ── Email (verification / reset). Dev uses a console transport. ─
MAIL_TRANSPORT=console
MAIL_FROM="FlowDesk <no-reply@flowdesk.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Cloudinary (media storage) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=flowdesk

# ── Misc ────────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120
LOG_LEVEL=debug
