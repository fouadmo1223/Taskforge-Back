{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@flowdesk/types": ["packages/types/src/index.ts"],
      "@flowdesk/types/*": ["packages/types/src/*"],
      "@flowdesk/config": ["packages/config/src/index.ts"],
      "@flowdesk/utils": ["packages/utils/src/index.ts"],
      "@flowdesk/utils/*": ["packages/utils/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", "coverage"]
}
